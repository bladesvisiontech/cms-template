# GitHub token with repo read/write access (client's account)
GITHUB_TOKEN=ghp_your_token_here

# GitHub account username (client's account)
GITHUB_OWNER=client-github-username

# Repository name of the CLIENT'S WEBSITE (not this CMS repo)
GITHUB_REPO=client-website-repo-name

# Branch to commit to
GITHUB_BRANCH=main

# Path inside the website repo where JSON data files live
# e.g. "src/data" for React/Vite sites, "data" for static HTML sites
CONTENT_BASE_PATH=data

# Public URL of the client's live website (used for image previews)
NEXT_PUBLIC_PREVIEW_URL=https://client-website.com

# Random secret string for JWT session tokens (generate any long string)
JWT_SECRET=your-secret-key-here

# CMS login credentials
ADMIN_EMAIL=client@email.com
ADMIN_PASSWORD_HASH=bcrypt_hash_of_password
